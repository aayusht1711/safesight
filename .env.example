# ============================================================
# SafeSight AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# --- App Settings ---
APP_ENV=development               # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Model Paths / HuggingFace Hub IDs ---
VLM_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
DEBERTA_MODEL_ID=martin-ha/toxic-comment-model
WHISPER_MODEL_SIZE=tiny           # tiny | base | small

# --- Quantization ---
VLM_LOAD_IN_4BIT=true
VLM_BNB_COMPUTE_DTYPE=float16    # float16 | bfloat16

# --- Tier-1 Gate Config ---
CLIP_MODEL_NAME=hf-hub:laion/CLIP-ViT-B-32-laion2B-s34B-b79K
TIER1_CONFIDENCE_THRESHOLD=0.82   # Posts scoring above this → auto-approved
TIER1_SUSPICIOUS_THRESHOLD=0.45   # Posts scoring below this → auto-flagged

# --- Pipeline Latency Budgets (ms) ---
TIER1_TIMEOUT_MS=50
TIER2_TIMEOUT_MS=700

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Device ---
DEVICE=cuda                       # cuda | cpu | mps

# --- HuggingFace Hub (set if using private models) ---
# HF_TOKEN=hf_your_token_here

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
